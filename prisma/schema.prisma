generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["acquisition", "audit", "master", "public"]
}

model acqu_mode {
  acq_mode_id       BigInt         @id(map: "aquisition_method_pkey")
  aquisition_method String         @db.VarChar(50)
  entry_by          String?        @db.VarChar(10)
  updt_by           String?        @db.VarChar(10)
  entry_ts          BigInt?        @default(dbgenerated("date_part('epoch'::text, now())"))
  updt_ts           BigInt?        @default(dbgenerated("date_part('epoch'::text, now())"))
  del_ts            BigInt?
  acq_proposal      acq_proposal[]

  @@schema("master")
}

model area_master {
  area_cd         String           @id @db.VarChar(30)
  area_en         String           @db.VarChar(255)
  area_loc_vern   String?          @db.VarChar(255)
  is_active       Boolean?         @default(true)
  state_lgd       BigInt?
  entry_by        String?          @db.VarChar(50)
  updt_by         String?          @db.VarChar(50)
  entry_ts        BigInt?          @default(dbgenerated("date_part('epoch'::text, now())"))
  updt_ts         BigInt?          @default(dbgenerated("date_part('epoch'::text, now())"))
  del_ts          BigInt?
  area_remarks    String?
  short_nm        String?          @db.VarChar(10)
  acq_proposal    acq_proposal[]
  user_org_scopes user_org_scope[]

  @@schema("master")
}

model block_master {
  block_lgd      BigInt   @id
  block_en       String   @db.VarChar(255)
  block_loc_vern String?  @db.VarChar(255)
  district_lgd   BigInt
  is_active      Boolean? @default(true)
  entry_by       String?  @db.VarChar(10)
  updt_by        String?  @db.VarChar(10)
  entry_ts       BigInt?  @default(dbgenerated("date_part('epoch'::text, now())"))
  updt_ts        BigInt?  @default(dbgenerated("date_part('epoch'::text, now())"))
  del_ts         BigInt?
  state_lgd      BigInt?

  @@schema("master")
}

model cast_master {
  cast_id   BigInt  @id
  cast_type String  @db.VarChar(255)
  entry_by  String? @db.VarChar(10)
  updt_by   String? @db.VarChar(10)
  entry_ts  BigInt? @default(dbgenerated("date_part('epoch'::text, now())"))
  updt_ts   BigInt? @default(dbgenerated("date_part('epoch'::text, now())"))
  del_ts    BigInt?

  @@schema("master")
}

model chk_master_new {
  chk_id           Int      @id
  chk_description  String?
  chk_type         String?  @db.VarChar(15)
  chk_sub_type     String?  @db.VarChar(15)
  chk_inp_type     String?  @db.VarChar(50)
  acq_mode_id      BigInt?
  entry_by         String?  @db.VarChar(10)
  updt_by          String?  @db.VarChar(10)
  entry_ts         BigInt?
  updt_ts          BigInt?
  is_initial       Boolean?
  noti_type        String?  @db.VarChar(30)
  chk_inp_instruc  String?
  local_vernacular String?

  @@schema("master")
}

model district_master {
  district_lgd      BigInt   @id
  district_en       String   @db.VarChar(255)
  district_loc_vern String?  @db.VarChar(255)
  state_lgd         BigInt
  is_active         Boolean? @default(true)
  entry_by          String?  @db.VarChar(10)
  updt_by           String?  @db.VarChar(10)
  entry_ts          BigInt?  @default(dbgenerated("date_part('epoch'::text, now())"))
  updt_ts           BigInt?  @default(dbgenerated("date_part('epoch'::text, now())"))
  del_ts            BigInt?

  @@schema("master")
}

model landclass_master {
  landc_id     BigInt   @id
  landt_id     BigInt?
  land_class   String   @db.VarChar(255)
  entry_by     String?  @db.VarChar(10)
  updt_by      String?  @db.VarChar(10)
  entry_ts     BigInt?  @default(dbgenerated("date_part('epoch'::text, now())"))
  updt_ts      BigInt?  @default(dbgenerated("date_part('epoch'::text, now())"))
  del_ts       BigInt?
  loc_vern     String?  @db.VarChar(30)
  district_lgd BigInt?
  is_active    Boolean? @default(true)

  @@schema("master")
}

model landtype_master {
  landt_id                BigInt                    @id
  land_type               String                    @db.VarChar(255)
  entry_by                String?                   @db.VarChar(10)
  updt_by                 String?                   @db.VarChar(10)
  entry_ts                BigInt?                   @default(dbgenerated("date_part('epoch'::text, now())"))
  updt_ts                 BigInt?                   @default(dbgenerated("date_part('epoch'::text, now())"))
  del_ts                  BigInt?
  plot_schedule_land_type plot_schedule_land_type[]

  @@schema("master")
}

model mine_master {
  mine_cd           String           @id @db.VarChar(30)
  mine_en           String           @db.VarChar(255)
  mine_loc_vern     String?          @db.VarChar(255)
  area_cd           String?          @db.VarChar(30)
  area_coverd       Decimal?         @db.Decimal
  area_aquired      Decimal?         @db.Decimal
  entry_by          String?          @db.VarChar(10)
  updt_by           String?          @db.VarChar(10)
  entry_ts          BigInt?          @default(dbgenerated("date_part('epoch'::text, now())"))
  updt_ts           BigInt?          @default(dbgenerated("date_part('epoch'::text, now())"))
  del_ts            BigInt?
  is_active         Boolean          @default(true)
  state_lgd         BigInt?
  mine_remarks      String?
  adjacent_mine_ids String[]         @default([])
  acq_proposal      acq_proposal[]
  user_org_scopes   user_org_scope[]

  @@schema("master")
}

model mouza_master {
  mouza_lgd      BigInt          @id
  mouza_en       String          @db.VarChar(255)
  mouza_loc_vern String?         @db.VarChar(255)
  block_lgd      BigInt
  is_active      Boolean?        @default(true)
  jl_no          String?         @db.VarChar(3)
  entry_by       String?         @db.VarChar(10)
  updt_by        String?         @db.VarChar(10)
  entry_ts       BigInt?         @default(dbgenerated("date_part('epoch'::text, now())"))
  updt_ts        BigInt?         @default(dbgenerated("date_part('epoch'::text, now())"))
  del_ts         BigInt?
  state_lgd      BigInt?
  district_lgd   BigInt?
  gis_enable     Boolean         @default(false)
  halka_no       String?         @db.VarChar(2)
  plot_schedule  plot_schedule[]

  @@schema("master")
}

model owner_type_master {
  owner_type_id BigInt  @id
  owner_type    String  @db.VarChar(255)
  entry_by      String? @db.VarChar(10)
  updt_by       String? @db.VarChar(10)
  entry_ts      BigInt? @default(dbgenerated("date_part('epoch'::text, now())"))
  updt_ts       BigInt? @default(dbgenerated("date_part('epoch'::text, now())"))
  del_ts        BigInt?

  @@schema("master")
}

model present_land_use {
  id               BigInt @id
  present_land_use String @db.VarChar(50)

  @@schema("master")
}

model ps_master {
  ps_lgd       BigInt   @id
  ps_en        String   @db.VarChar(255)
  ps_loc_vern  String?  @db.VarChar(255)
  district_lgd BigInt
  is_active    Boolean? @default(true)
  entry_by     String?  @db.VarChar(10)
  updt_by      String?  @db.VarChar(10)
  entry_ts     BigInt?  @default(dbgenerated("date_part('epoch'::text, now())"))
  updt_ts      BigInt?  @default(dbgenerated("date_part('epoch'::text, now())"))
  del_ts       BigInt?
  state_lgd    BigInt?

  @@schema("master")
}

model state_master {
  state_lgd      BigInt   @id
  state_en       String   @db.VarChar(255)
  state_loc_vern String?  @db.VarChar(255)
  short_code     String?  @db.VarChar(20)
  is_active      Boolean? @default(true)
  entry_by       String?  @db.VarChar(10)
  updt_by        String?  @db.VarChar(10)
  entry_ts       BigInt?  @default(dbgenerated("date_part('epoch'::text, now())"))
  updt_ts        BigInt?  @default(dbgenerated("date_part('epoch'::text, now())"))
  del_ts         BigInt?

  @@schema("master")
}

model vill_master {
  village_lgd   BigInt   @id(map: "village_master_pkey")
  village_name  String   @db.VarChar(255)
  vill_loc_vern String   @db.VarChar(255)
  block_lgd     BigInt
  ps_lgd        BigInt
  entry_by      String?  @db.VarChar(10)
  updt_by       String?  @db.VarChar(10)
  entry_ts      BigInt?  @default(dbgenerated("date_part('epoch'::text, now())"))
  updt_ts       BigInt?  @default(dbgenerated("date_part('epoch'::text, now())"))
  del_ts        BigInt?
  is_active     Boolean? @default(true)
  district_lgd  BigInt?
  state_lgd     BigInt?
  vill_cd       String?  @db.VarChar(50)

  @@schema("master")
}

model Project {
  projCd              String         @id(map: "pk_project") @map("proj_cd") @db.VarChar(30)
  eclProjCd           String?        @map("ecl_proj_cd") @db.VarChar(30)
  projNm              String         @map("proj_nm") @db.VarChar(255)
  projectDesc         String?        @map("project_desc")
  totalApprovedArea   Decimal?       @default(0) @map("total_approved_area") @db.Decimal(12, 4)
  totalAcquiredArea   Decimal?       @default(0) @map("total_acquired_area") @db.Decimal(12, 4)
  totalEmpSanctioned  Int?           @default(0) @map("total_emp_sanctioned")
  totalEmpCompleted   Int?           @default(0) @map("total_emp_completed")
  landBudget          Decimal?       @default(0) @map("land_budget") @db.Decimal(18, 2)
  rrBudget            Decimal?       @default(0) @map("rr_budget") @db.Decimal(18, 2)
  status              Int?           @default(0) @db.SmallInt
  remarks             String?
  isActive            Boolean?       @default(true) @map("is_active")
  entryBy             String?        @map("entry_by") @db.VarChar(20)
  updtBy              String?        @map("updt_by") @db.VarChar(20)
  entryTs             BigInt?        @default(dbgenerated("date_part('epoch'::text, now())")) @map("entry_ts")
  updtTs              BigInt?        @default(dbgenerated("date_part('epoch'::text, now())")) @map("updt_ts")
  delTs               BigInt?        @map("del_ts")
  tenantId            String?        @map("tenant_id") @db.VarChar(50)
  statutoryClearances Json?          @map("statutory_clearances")
  boundary            String?
  lockedAt            DateTime?      @map("locked_at") @db.Timestamp(6)
  acq_proposal        acq_proposal[]
  approvals           ProjAprv[]
  tenant              Tenant?        @relation(fields: [tenantId], references: [tenantId], onDelete: NoAction, onUpdate: NoAction, map: "fk_project_tenant")

  @@index([isActive], map: "idx_project_is_active")
  @@index([tenantId], map: "idx_project_tenant_id")
  @@map("project")
  @@schema("master")
}

model ProjAprv {
  aprvCd      BigInt             @id(map: "pk_proj_aprv") @map("aprv_cd")
  projCd      String             @map("proj_cd") @db.VarChar(30)
  aprvArea    Decimal?           @map("aprv_area") @db.Decimal
  areaAcq     Decimal?           @default(0) @map("area_acq") @db.Decimal
  empSanc     Int?               @map("emp_sanc")
  aprvDt      DateTime?          @map("aprv_dt") @db.Date
  aprvRefNo   String?            @map("aprv_ref_no") @db.VarChar(200)
  isActive    Boolean?           @default(true) @map("is_active")
  remark      String?
  districtLgd String?            @map("district_lgd")
  psLgd       String?            @map("ps_lgd")
  blockLgd    String?            @map("block_lgd")
  mouzaLgd    String?            @map("mouza_lgd")
  propId      BigInt?            @map("prop_id")
  rrCap       Decimal?           @map("rr_cap") @db.Decimal(15, 2)
  landCap     Decimal?           @map("land_cap") @db.Decimal(15, 2)
  entryBy     String?            @map("entry_by") @db.VarChar(10)
  updtBy      String?            @map("updt_by") @db.VarChar(10)
  entryTs     BigInt?            @default(dbgenerated("date_part('epoch'::text, now())")) @map("entry_ts")
  updtTs      BigInt?            @default(dbgenerated("date_part('epoch'::text, now())")) @map("updt_ts")
  delTs       BigInt?            @map("del_ts")
  aprvType    String?            @map("aprv_type") @db.VarChar(30)
  aprvDocId   String?            @map("aprv_doc_id") @db.VarChar(50)
  aprvLevel   String?            @map("aprv_level") @db.VarChar(30)
  land_budget Decimal?           @db.Decimal(18, 2)
  rr_budget   Decimal?           @db.Decimal(18, 2)
  project     Project            @relation(fields: [projCd], references: [projCd], onDelete: NoAction, onUpdate: NoAction, map: "fk_proj_aprv_project")
  locations   ProjAprvLocation[]

  @@index([aprvType], map: "idx_proj_aprv_aprv_type")
  @@index([isActive], map: "idx_proj_aprv_is_active")
  @@index([projCd], map: "idx_proj_aprv_proj_cd")
  @@map("proj_aprv")
  @@schema("master")
}

model ProjAprvLocation {
  aprvLocationCode String   @id(map: "pk_proj_aprv_location") @map("aprv_location_code") @db.VarChar(10)
  aprvCd           BigInt   @map("aprv_cd")
  areaCd           String?  @map("area_cd") @db.VarChar(30)
  mineCd           String?  @map("mine_cd") @db.VarChar(30)
  mouzaLgd         BigInt   @map("mouza_lgd")
  approvedArea     Decimal  @default(0) @map("approved_area") @db.Decimal(12, 4)
  locationRemark   String?  @map("location_remark")
  entryBy          String?  @map("entry_by") @db.VarChar(20)
  updtBy           String?  @map("updt_by") @db.VarChar(20)
  entryTs          BigInt?  @default(dbgenerated("date_part('epoch'::text, now())")) @map("entry_ts")
  updtTs           BigInt?  @default(dbgenerated("date_part('epoch'::text, now())")) @map("updt_ts")
  delTs            BigInt?  @map("del_ts")
  landClassBreakup Json?    @map("land_class_breakup")
  approval         ProjAprv @relation(fields: [aprvCd], references: [aprvCd], onDelete: NoAction, onUpdate: NoAction, map: "fk_proj_aprv_location_aprv")

  @@index([aprvCd], map: "idx_proj_aprv_location_aprv_cd")
  @@index([mouzaLgd], map: "idx_proj_aprv_location_mouza_lgd")
  @@map("proj_aprv_location")
  @@schema("master")
}

model Tenant {
  tenantId   String    @id(map: "pk_tenant") @map("tenant_id") @db.VarChar(50)
  tenantCode String    @unique(map: "uq_tenant_code") @map("tenant_code") @db.VarChar(20)
  tenantName String    @map("tenant_name") @db.VarChar(255)
  tenantType String?   @map("tenant_type") @db.VarChar(30)
  parentOrg  String?   @map("parent_org") @db.VarChar(255)
  isActive   Boolean?  @default(true) @map("is_active")
  entryBy    String?   @map("entry_by") @db.VarChar(20)
  updtBy     String?   @map("updt_by") @db.VarChar(20)
  entryTs    BigInt?   @default(dbgenerated("date_part('epoch'::text, now())")) @map("entry_ts")
  updtTs     BigInt?   @default(dbgenerated("date_part('epoch'::text, now())")) @map("updt_ts")
  delTs      BigInt?   @map("del_ts")
  projects   Project[]
  user       user[]

  @@index([isActive], map: "idx_tenant_is_active")
  @@map("tenant")
  @@schema("master")
}

model audit_download {
  id          String   @id
  user_id     String?
  file_type   String
  file_name   String
  entity_type String?
  entity_id   String?
  ip_address  String?
  entry_ts    DateTime @default(now())
  updt_ts     DateTime
  entry_by    String?
  updt_by     String?

  @@schema("public")
}

model auth_session {
  id         String   @id
  token      String   @unique
  expires_at DateTime
  entry_ts   DateTime @default(now())
  updt_ts    DateTime
  entry_by   String?
  updt_by    String?
  user_id    Int
  user       user     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@schema("public")
}

model background_job {
  id           String   @id
  job_type     String
  payload      String
  status       String
  locked_by    String?
  attempts     Int      @default(0)
  max_attempts Int      @default(3)
  entry_ts     DateTime @default(now())
  updt_ts      DateTime
  entry_by     String?
  updt_by      String?

  @@schema("public")
}

model captcha_audit_log {
  id         String   @id
  action     String
  ip_address String?
  purpose    String
  timestamp  DateTime @default(now())
  entry_ts   DateTime @default(now())
  updt_ts    DateTime
  entry_by   String?
  updt_by    String?

  @@schema("public")
}

model captcha_challenge {
  id              String   @id
  expected_answer String
  purpose         String
  expires_at      DateTime
  attempts        Int      @default(0)
  ip_address      String?
  user_agent      String?
  entry_ts        DateTime @default(now())
  updt_ts         DateTime
  entry_by        String?
  updt_by         String?

  @@schema("public")
}

model captcha_config {
  id                      String   @id @default("global")
  provider                String   @default("math")
  difficulty              String   @default("difficult")
  expiration_minutes      Int      @default(5)
  max_attempts            Int      @default(3)
  adaptive_captcha        Boolean  @default(true)
  show_after_failed_login Int      @default(3)
  updt_ts                 DateTime
  entry_ts                DateTime @default(now())
  entry_by                String?
  updt_by                 String?

  @@schema("public")
}

model compensation_payroll {
  id                        String                      @id
  project_id                String
  payroll_code              String
  multiplication_factor     Decimal                     @default(1.0000) @db.Decimal(6, 4)
  state                     String                      @default("Drafting")
  landowner_count           Int                         @default(0)
  total_award               Decimal                     @default(0.00) @db.Decimal(15, 2)
  meta                      String?
  entry_ts                  DateTime                    @default(now())
  updt_ts                   DateTime
  entry_by                  String?
  updt_by                   String?
  compensation_payroll_line compensation_payroll_line[]

  @@schema("public")
}

model compensation_payroll_line {
  id                       String               @id
  payroll_id               String
  landowner_name           String
  plot_reference           String
  land_value               Decimal              @db.Decimal(15, 2)
  asset_value              Decimal              @db.Decimal(15, 2)
  solatium_amount          Decimal              @default(0.00) @db.Decimal(15, 2)
  escalation_amount        Decimal              @default(0.00) @db.Decimal(15, 2)
  total_award              Decimal              @default(0.00) @db.Decimal(15, 2)
  years_since_notification Int                  @default(0)
  formula_snapshot         String
  entry_ts                 DateTime             @default(now())
  updt_ts                  DateTime
  entry_by                 String?
  updt_by                  String?
  compensation_payroll     compensation_payroll @relation(fields: [payroll_id], references: [id])

  @@schema("public")
}

model document {
  id                 String   @id
  vaultable_type     String
  vaultable_id       String
  checklist_item_key String
  file_name          String
  storage_path       String
  mime_type          String
  file_size_kb       Int
  virus_scan_status  String   @default("clean")
  uploaded_by        String
  entry_ts           DateTime @default(now())
  updt_ts            DateTime
  entry_by           String?
  updt_by            String?

  @@schema("public")
}

model document_instance {
  id                       String            @id
  template_code            String
  application_id           String
  document_id              String?
  status                   String            @default("DRAFT")
  form_data                Json?
  generated_docx_path      String?
  generated_pdf_path       String?
  generated_docx_id        String?
  generated_pdf_id         String?
  resolver_fields_json     Json?
  resolver_tables_json     Json?
  resolver_signatures_json Json?
  final_fields_json        Json?
  signature_data_json      Json?
  resolver_version         String?
  entry_ts                 DateTime          @default(now())
  updt_ts                  DateTime          @default(now())
  entry_by                 String?
  updt_by                  String?
  document_template        document_template @relation(fields: [template_code], references: [template_code])

  @@schema("public")
}

model document_template {
  id                          String                        @id
  template_code               String                        @unique
  template_name               String
  description                 String?
  storage_path                String
  config                      Json?
  is_active                   Boolean                       @default(true)
  entry_ts                    DateTime                      @default(now())
  updt_ts                     DateTime                      @default(now())
  entry_by                    String?
  updt_by                     String?
  document_instance           document_instance[]
  document_template_field     document_template_field[]
  document_template_signature document_template_signature[]

  @@schema("public")
}

model document_template_field {
  id                String            @id
  template_code     String
  field_key         String
  field_type        String
  label             String
  options           Json?
  show_if           Json?
  is_required       Boolean           @default(false)
  display_order     Int               @default(0)
  is_active         Boolean           @default(true)
  entry_ts          DateTime          @default(now())
  updt_ts           DateTime          @default(now())
  entry_by          String?
  updt_by           String?
  document_template document_template @relation(fields: [template_code], references: [template_code], onDelete: Cascade)

  @@schema("public")
}

model document_template_signature {
  id                String            @id @default(dbgenerated("gen_random_uuid()"))
  template_code     String
  role              String
  workflow_state    String?
  placeholders      Json
  is_required       Boolean           @default(true)
  display_order     Int               @default(0)
  entry_ts          DateTime          @default(now())
  updt_ts           DateTime          @default(now())
  document_template document_template @relation(fields: [template_code], references: [template_code], onDelete: Cascade)

  @@schema("public")
}

model download_log {
  id            String   @id
  file_type     String
  document_id   String?
  storage_path  String
  downloaded_by String?
  user_name     String?
  ip_address    String?
  browser       String?
  entry_ts      DateTime @default(now())
  updt_ts       DateTime
  entry_by      String?
  updt_by       String?

  @@schema("public")
}

model employment_application {
  id                    String       @id
  application_code      String
  project_id            String
  nominee_pool_id       String
  form_ix_balance_acres Decimal      @db.Decimal(10, 4)
  form_x_balance_jobs   Int
  state                 String       @default("Drafting")
  exception_flags       String?
  entry_ts              DateTime     @default(now())
  updt_ts               DateTime
  entry_by              String?
  updt_by               String?
  nominee_pool          nominee_pool @relation(fields: [nominee_pool_id], references: [id])

  @@schema("public")
}

model event_registry {
  id                String              @id
  event_name        String              @unique
  module            String
  description       String?
  entry_ts          DateTime            @default(now())
  updt_ts           DateTime
  entry_by          String?
  updt_by           String?
  notification_rule notification_rule[]

  @@schema("public")
}

model file_attachment {
  id          String      @id
  file_id     String
  entity_type String
  entity_id   String
  module      String?
  attached_by String?
  entry_ts    DateTime    @default(now())
  updt_ts     DateTime
