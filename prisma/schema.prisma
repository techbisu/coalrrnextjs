  transition_id   String   @id @default(dbgenerated("gen_random_uuid()")) @db.VarChar(64)
  workflow_code   String   @db.VarChar(60)
  transition_name String   @db.VarChar(80)
  label           String   @db.VarChar(120)
  from_state      String   @db.VarChar(60)
  to_state        String   @db.VarChar(60)
  required_role   String   @db.VarChar(60)
  guard_key       String?  @db.VarChar(80)
  is_active       Boolean  @default(true)
  sort_order      Int      @default(0)

  entry_ts        DateTime @default(now()) @db.Timestamptz(6)
  updt_ts         DateTime @default(now()) @updatedAt @db.Timestamptz(6)
  entry_by        String?  @db.VarChar(64)
  updt_by         String?  @db.VarChar(64)

  @@unique([workflow_code, transition_name], map: "uq_workflow_transition")
  @@schema("public")
}

model deadline_tracker {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  entity_type   String    @db.VarChar(64)
  entity_id     String    @db.VarChar(64)
  deadline_type String    @db.VarChar(64)
  due_date      DateTime  @db.Date
  reminder_sent Boolean   @default(false)
  closed_at     DateTime? @db.Timestamptz(6)
  entry_by      String    @db.VarChar(64)
  entry_ts      DateTime  @default(now()) @db.Timestamptz(6)
  updt_ts       DateTime  @default(now()) @db.Timestamptz(6)

  @@index([entity_type, entity_id], map: "idx_deadline_entity")
  @@schema("public")
}

model manual_milestone {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  entity_type    String    @db.VarChar(64)
  entity_id      String    @db.VarChar(64)
  milestone_type String    @db.VarChar(64)
  authority_name String?   @db.VarChar(256)
  reference_no   String?   @db.VarChar(128)
  sent_at        DateTime? @db.Timestamptz(6)
  received_at    DateTime? @db.Timestamptz(6)
  outcome        String?   @db.VarChar(32)
  remarks        String?
  document_id    String?   @db.VarChar(64)
  entry_by       String    @db.VarChar(64)
  entry_ts       DateTime  @default(now()) @db.Timestamptz(6)
  updt_ts        DateTime  @default(now()) @db.Timestamptz(6)

  @@index([entity_type, entity_id], map: "idx_manual_milestone_entity")
  @@index([milestone_type, outcome], map: "idx_manual_milestone_type")
  @@schema("public")
}

model proposal_snapshot {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  proposal_id   String   @db.VarChar(64)
  version       Int      @default(1)
  snapshot_type String   @db.VarChar(64)
  data          Json
  generated_by  String   @db.VarChar(64)
  entry_ts      DateTime @default(now()) @db.Timestamptz(6)

  @@unique([proposal_id, version])
  @@index([proposal_id], map: "idx_proposal_snapshot_proposal")
  @@schema("public")
}

model workflow_states {
  state_id      String   @id @default(dbgenerated("(gen_random_uuid())::text")) @db.VarChar(64)
  workflow_code String   @db.VarChar(60)
  state_code    String   @db.VarChar(60)
  label         String   @db.VarChar(120)
  description   String?
  color         String?  @db.VarChar(120)
  icon          String?  @db.VarChar(60)
  step_order    Decimal  @default(1.00) @db.Decimal(5, 2)
  is_terminal   Boolean  @default(false)
  is_active     Boolean  @default(true)
  entry_ts      DateTime @default(now()) @db.Timestamptz(6)
  updt_ts       DateTime @default(now()) @updatedAt @db.Timestamptz(6)
  entry_by      String?  @default("system") @db.VarChar(64)
  updt_by       String?  @default("system") @db.VarChar(64)

  @@unique([workflow_code, state_code], map: "uq_workflow_state")
  @@index([workflow_code, step_order], map: "idx_wfs_code_order")
  @@schema("public")
}

model workflow_action_history {
  wah_id        String   @id @default(dbgenerated("(gen_random_uuid())::text")) @db.VarChar(64)
  entity_type   String   @db.VarChar(64)
  entity_id     String   @db.VarChar(64)
  workflow_code String   @db.VarChar(60)
  action        String   @db.VarChar(80)
  from_state    String   @db.VarChar(60)
  to_state      String   @db.VarChar(60)
  user_id       Int?
  comments      String?
  entry_ts      DateTime @default(now()) @db.Timestamptz(6)
  updt_ts       DateTime @default(now()) @updatedAt @db.Timestamptz(6)
  entry_by      String?  @db.VarChar(64)
  updt_by       String?  @db.VarChar(64)
  user          user?    @relation(fields: [user_id], references: [id], onUpdate: NoAction, map: "fk_wah_user")

  @@index([entity_type, entity_id, entry_ts(sort: Desc)], map: "idx_wah_polymorphic")
  @@index([user_id], map: "idx_wah_user_id")
  @@schema("public")
}

enum ScopeLevel {
  HQ
  AREA
  UNIT

  @@schema("public")
}
